{
  "name": "lumen-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:fake": "vite --mode fake",
    "build": "npm run build:local && npm run build:aws && npm run build:emqx",
    "build:local": "vite build --mode node",
    "build:aws": "vite build --mode aws",
    "build:emqx": "vite build --mode emqx",
    "build:dev": "vite build --mode dev",
    "build:fake": "vite build --mode fake",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-iot": "3.1152.0",
    "@msgpack/msgpack": "3.1.3",
    "aws-amplify": "6.22.2",
    "aws-iot-device-sdk-v2": "1.28.1",
    "lit-html": "3.3.3",
    "mqtt": "5.16.1",
    "uplot": "1.6.32",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "aedes": "1.2.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "ws": "8.22.0"
  }
}
