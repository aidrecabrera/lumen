{
  "name": "lumen-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:fake": "vite --mode fake",
    "build": "npm run build:local && npm run build:aws && npm run build:emqx",
    "build:local": "vite build --mode local",
    "build:aws": "vite build --mode aws",
    "build:emqx": "vite build --mode emqx",
    "build:dev": "vite build --mode dev",
    "build:fake": "vite build --mode fake",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "lit-html": "3.3.3",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
